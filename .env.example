# --- Database (Supabase / PostgreSQL) ---
# 앱 런타임(서버리스)용 풀링 연결 — Supabase의 "Connection pooling"(포트 6543) 문자열.
#   예: postgresql://postgres.xxxx:비번@aws-0-리전.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# 마이그레이션(prisma db push)용 다이렉트 연결 — Supabase의 "Direct connection"(포트 5432).
#   예: postgresql://postgres.xxxx:비번@aws-0-리전.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# (로컬 개발용) 로컬 Postgres 예시:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hr?schema=public"

# --- App ---
APP_URL="http://localhost:3000"
# 관리자 로그인 비밀번호 (간단 보호). 배포 시 반드시 변경하세요.
ADMIN_PASSWORD="yoossam2025"
# 세션 서명 시크릿 (배포 시 무작위 문자열로 변경)
SESSION_SECRET="change-this-to-a-long-random-string"

# --- PDF (Chromium) ---
# 로컬/자체서버는 비워두면 설치된 Chrome/Edge/Chromium 자동 탐색. 필요 시에만 직접 지정.
CHROMIUM_PATH=""
# Vercel 등 서버리스에서 사용할 원격 Chromium 팩 URL. 비우면 기본값(v131) 사용.
CHROMIUM_PACK_URL=""

# --- SMTP (급여명세서 이메일 발송) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="주식회사 유쌤에듀 <no-reply@yoossam.edu>"

# --- Slack (연차 신청/승인) ---
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# 연차 신청이 게시될 관리자 채널 ID (예: C0123ABCD)
SLACK_APPROVAL_CHANNEL=""
# 연차 승인 권한을 가진 슬랙 사용자 ID (쉼표구분, 비우면 채널 누구나 승인 가능)
SLACK_APPROVERS=""

# --- Scheduler ---
# 내부 스케줄러 활성화 (자동 발송). 서버리스 배포 시 false 후 외부 크론 사용.
ENABLE_SCHEDULER="true"
# 외부 크론에서 호출할 때 사용할 보안 토큰
CRON_SECRET="change-this-cron-secret"
