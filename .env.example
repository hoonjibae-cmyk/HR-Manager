# --- Database ---
DATABASE_URL="file:./dev.db"

# --- App ---
APP_URL="http://localhost:3000"
# 관리자 로그인 비밀번호 (간단 보호). 배포 시 반드시 변경하세요.
ADMIN_PASSWORD="변경하세요"
# 세션 서명 시크릿 (배포 시 무작위 문자열로 변경)
SESSION_SECRET="change-this-to-a-long-random-string"

# --- PDF (Playwright/Chromium) ---
# 사전 설치된 Chromium 경로 (이 환경 기준). 로컬에서는 비워두면 자동 탐색.
CHROMIUM_PATH="/opt/pw-browsers/chromium/chrome-linux/chrome"

# --- SMTP (급여명세서 이메일 발송) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="㈜유쌤에듀 <no-reply@yoossam.edu>"

# --- Slack (연차 신청/승인) ---
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# 연차 신청이 게시될 관리자 채널 ID (예: C0123ABCD)
SLACK_APPROVAL_CHANNEL=""
# 연차 승인 권한을 가진 슬랙 사용자 ID (쉼표구분, 비우면 채널 누구나 승인 가능)
SLACK_APPROVERS=""

# --- Scheduler ---
# 내부 스케줄러 활성화 (자동 발송). 서버리스 배포 시 false 후 외부 크론 사용.
ENABLE_SCHEDULER="true"
# 외부 크론에서 호출할 때 사용할 보안 토큰
CRON_SECRET="change-this-cron-secret"
