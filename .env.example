# --- Database (Supabase / PostgreSQL) ---
# 앱 런타임(서버리스)용 풀링 연결 — Supabase의 "Connection pooling"(포트 6543) 문자열.
#   예: postgresql://postgres.xxxx:비번@aws-0-리전.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# 마이그레이션(prisma db push)용 다이렉트 연결 — Supabase의 "Direct connection"(포트 5432).
#   예: postgresql://postgres.xxxx:비번@aws-0-리전.pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# (로컬 개발용) 로컬 Postgres 예시:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/hr?schema=public"

# --- App ---
# 배포 주소. 슬랙 알림의 링크 버튼(계약 종료 예고 → 직원 카드)이 이 값으로 주소를 만든다.
# 도메인을 바꾸면 여기도 바꾸고 **재배포**해야 한다 (빌드 시점에 굳는다). 자세히는 docs/DEPLOY.md 3-1단계.
APP_URL="http://localhost:3000"
# 관리자 로그인 비밀번호 (간단 보호). 배포 시 반드시 변경하세요.
ADMIN_PASSWORD="yoossam2025"
# 세션 서명 시크릿 (배포 시 무작위 문자열로 변경)
SESSION_SECRET="change-this-to-a-long-random-string"

# 개인정보 암호화 키 — 주민등록번호·계좌번호를 DB 에 암호문으로 저장한다.
#   만들기:  openssl rand -base64 32
#   기존 평문 데이터 옮기기:  npm run db:encrypt-pii  (미리보기) → APPLY=1 npm run db:encrypt-pii
# ⚠️ 이 키를 잃으면 암호화된 주민번호·계좌번호를 영영 읽지 못합니다. 반드시 따로 보관하세요.
# ⚠️ 값을 바꾸면 이미 저장된 값을 못 읽습니다 (바꾸려면 옛 키로 복호화 후 새 키로 재암호화).
# 비워 두면 평문으로 저장되며 설정 화면에 경고가 뜹니다.
ENCRYPTION_KEY=""

# --- PDF (Chromium) ---
# 로컬/자체서버는 비워두면 설치된 Chrome/Edge/Chromium 자동 탐색. 필요 시에만 직접 지정.
CHROMIUM_PATH=""
# Vercel 등 서버리스에서 사용할 원격 Chromium 팩 URL. 비우면 기본값(v131) 사용.
CHROMIUM_PACK_URL=""

# --- SMTP (급여명세서 이메일 발송) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="주식회사 유쌤에듀 <no-reply@yoossam.edu>"

# --- Slack (연차 신청/승인) ---
SLACK_BOT_TOKEN=""
SLACK_SIGNING_SECRET=""
# 휴가 신청/취소 승인 카드가 게시될 운영진 채널 ID (예: #알림-운영진 → C0123ABCD)
SLACK_APPROVAL_CHANNEL=""
# 승인·취소 확정 내역이 기록될 채널 ID (예: #휴가-기록). 비우면 게시하지 않음
SLACK_RECORD_CHANNEL=""
# 연차 승인 권한을 가진 슬랙 사용자 ID (쉼표구분, 비우면 채널 누구나 승인 가능)
SLACK_APPROVERS=""
# 보강계획 사전신청이 공유될 채널 ID (예: #보강-신청). 비우면 신청자 DM 만 발송
SLACK_MAKEUP_CHANNEL=""

# 배포 시 DB 스키마 자동 반영을 끄고 싶을 때만 1 (기본: 자동 반영)
SKIP_DB_PUSH=""

# --- Scheduler ---
# 내부 스케줄러 활성화 (자동 발송). 서버리스 배포 시 false 후 외부 크론 사용.
ENABLE_SCHEDULER="true"
# 외부 크론에서 호출할 때 사용할 보안 토큰
CRON_SECRET="change-this-cron-secret"

# --- 공휴일 (한국천문연구원_특일 정보, 공공데이터포털) ---
# 음력 명절·대체공휴일·임시공휴일은 규칙만으로 못 구해 밖에서 받아 온다.
# data.go.kr 에서 무료로 신청하고 인증키를 넣는다 — Encoding·Decoding 어느 쪽이든 된다
# (앱이 `normalizeServiceKey` 로 맞춘다). 발급 직후에는 등록까지 1시간쯤 걸린다.
# 넣어 두면 표가 모자랄 때 크론이 알아서 채운다(설정 화면의 *공휴일 받아오기* 와 같은 일).
HOLIDAY_API_KEY=""

# --- 구글 캘린더 (승인된 휴가 자동 등록/삭제) ---
# 서비스 계정 이메일 (예: hr-bot@프로젝트.iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=""
# 서비스 계정 비공개 키 (JSON 의 private_key 값. 줄바꿈은 \n 그대로 두면 됨)
GOOGLE_PRIVATE_KEY=""
# 대상 캘린더 ID ('유쌤에듀-직원휴가일정' 캘린더 설정 → 캘린더 통합 → 캘린더 ID)
GOOGLE_CALENDAR_ID=""
# 보강 전용 캘린더 ID ('보강캘린더'). 휴가와 섞이면 안 되므로 반드시 별도로 지정한다.
# 비우면 보강 일정만 캘린더에 올라가지 않는다 (HR 시스템 등록·수당 산정은 정상 동작).
GOOGLE_MAKEUP_CALENDAR_ID=""
# 학사일정 캘린더 — 「학원방학」이 들어간 일정이 있는 날은 운영진 일일 안내를 보내지 않는다.
# 비워 두면 방학 판정만 꺼지고(토·일·공휴일 차단은 그대로) 나머지는 정상 동작한다.
GOOGLE_SCHOOL_CALENDAR_ID=""
