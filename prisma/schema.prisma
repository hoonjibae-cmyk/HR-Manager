// 유쌤에듀 HR 관리 프로그램 — 데이터 모델
// SQLite + Prisma. (SQLite는 Prisma enum 미지원 → 문자열 + 주석으로 허용값 표기)

generator client {
  provider      = "prisma-client-js"
  // Vercel(서버리스, Amazon Linux 2023) 런타임 바이너리 포함 — Node 버전과 무관
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // 앱 런타임: Supabase 풀링(pgbouncer, 6543) 연결
  url       = env("DATABASE_URL")
  // 마이그레이션(db push): 다이렉트(5432) 연결
  directUrl = env("DIRECT_URL")
}

/// 회사 기본정보 + 급여 기본설정 (단일 레코드, id=1)
model Company {
  id                   Int      @id @default(1)
  name                 String   @default("주식회사 유쌤에듀")
  ceo                  String   @default("유은정")
  bizNo                String   @default("418-86-02289")
  phone                String   @default("031-794-3306")
  address              String   @default("경기도 하남시 미사강변대로 216 한강트윈프라자2 3층")
  // 급여 기본설정
  payday               Int      @default(7) // 익월 지급일 (매월 n일)
  standardMonthlyHours Int      @default(209) // 월 소정근로 환산시간 (주40h 기준)
  weeksPerMonth        Float    @default(4.345)
  minWage              Int      @default(10030) // 최저시급(2025) — 통상시급 하한 참고
  mealAllowanceNonTax  Int      @default(200000) // 식대 비과세 한도(월)
  /// 은행 대량이체 파일의 '입금통장표시' 앞에 붙는 학원 약칭 — 직원 통장에 `유쌤_7월급여` 로 찍힌다.
  /// 통장 적요는 자리가 좁아 정식 상호(주식회사 유쌤에듀)를 그대로 쓰지 못한다.
  transferAlias        String   @default("유쌤")
  /// 학원 로고 — data URI(`data:image/png;base64,...`).
  /// 파일이 아니라 DB 에 담는다: 서버리스(Vercel)는 쓰기 가능한 파일 경로가 없고,
  /// 재배포 없이 화면에서 바꿀 수 있어야 하기 때문. 문서 PDF 도 이 값을 그대로 <img> 에 쓴다.
  logo                 String?
  /// 법인 인감(직인) — 로고와 같이 data URI 로 담는다. 배경이 뚫린 PNG 를 올리면
  /// 계약서 '대표자' 와 재직·경력증명서 '대표이사' 옆에 찍혀 나온다.
  /// 없으면 예전처럼 `(인)`·`(직인)` 글자만 찍혀 손도장을 찍을 자리가 된다.
  stamp                String?
  /// 간인(間印) — 2장 이상인 계약서에 장 경계마다 인감을 반씩 걸쳐 찍을지.
  /// 종이를 접어 찍던 관행을 그대로 옮긴 것이라 기본으로 켠다. 인감이 없으면 무관.
  stampSeam            Boolean  @default(true)
  /// 각 장 이니셜란 — 2장 이상인 계약서의 아래 여백에 `갑 (서명) ___ 을 (서명) ___` 줄을 넣을지.
  /// 장마다 서명을 받으면 민사소송법 §358 의 진정성립 추정이 그 장에 직접 붙는다(간인보다 곧바르다).
  pageInitials         Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

/// 4대보험 및 세율 (연도별 관리 가능, 기본 2025 요율)
model InsuranceRate {
  id                 Int     @id @default(autoincrement())
  year               Int     @unique
  // 근로자 부담분 요율 (소수, 예: 0.045 = 4.5%)
  nationalPension    Float   @default(0.045) // 국민연금 4.5%
  employment         Float   @default(0.009) // 고용보험 0.9%
  health             Float   @default(0.03545) // 건강보험 3.545%
  longTermCare       Float   @default(0.1295) // 장기요양 (건강보험료의 12.95%)
  localIncomeTaxRate Float   @default(0.1) // 지방소득세 (소득세의 10%)
  businessIncomeTax  Float   @default(0.03) // 사업소득 원천징수 3% (+지방세 0.3%)
  // 상한/하한 (국민연금 기준소득월액 상하한)
  pensionBaseMin     Int     @default(390000)
  pensionBaseMax     Int     @default(6170000)
  isActive           Boolean @default(true)
}

/// 근로소득 간이세액표 (제189조) — 월급여(천원) 구간별, 부양가족수(1~11)별 세액
model TaxBracket {
  id              Int    @id @default(autoincrement())
  loThousand      Int // 이상 (천원)
  hiThousand      Int? // 미만 (천원). null이면 최고구간
  // 부양가족수 1~11명 세액 (원). JSON 배열 [d1..d11]
  taxByDependents String

  @@index([loThousand])
}

/// 공휴일 (주휴/연차 계산 참고)
model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique
  name String
}

/// 부서 — 하드코딩 상수가 아니라 데이터로 둔다.
///
/// 부서마다 **입사 때 받아야 할 서류가 다르기 때문**이다(교수부만 복무서약서-II·프로필 홍보
/// 동의서, 조교팀은 건강서약서 제외 …). 부서를 코드에 박아 두면 부서가 하나 늘 때마다
/// 배포를 해야 하고, 새 부서에 어떤 서류가 나가야 하는지는 아무도 모르는 채로 남는다.
/// 그래서 부서를 추가할 때 **그 부서의 서류 정책을 함께 묻는다**(설정 화면).
model Department {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  /// 화면에 보이는 순서
  sortOrder Int     @default(0)
  /// 끈 부서는 새 직원에게 고를 수 없지만, 이미 그 부서인 직원의 서류 판정에는 계속 쓰인다
  active    Boolean @default(true)

  // --- 입사 서류 정책 — 이 부서 직원에게 무엇을 발급할지 ---
  /// 복무서약서-II (강의 운영 관련 조항) — 강의를 맡는 부서만
  docPledgeServiceII Boolean @default(false)
  /// 프로필 홍보 동의서 (학력·경력·사진의 홍보 활용) — 홍보에 얼굴이 나가는 부서만
  docPromotion       Boolean @default(false)
  /// 건강서약서
  docHealth          Boolean @default(true)
  /// 보안서약서의 **경업금지 조항**(퇴사 후 6개월·반경 2km 취업·운영 금지).
  /// 보안서약서 자체는 전 직원이 쓰고, 이 조항만 부서에 따라 붙였다 뗀다.
  docNonCompete      Boolean @default(false)

  /// 연차 중간결재자 — 지정된 부서의 연차 신청은 운영진 승인 전에 이 사람의 확인을 거친다.
  /// 비어 있으면 예전처럼 바로 운영진 승인으로 간다(부서마다 켜고 끄는 스위치 역할).
  leaveApproverId Int?
  leaveApprover   Employee? @relation("DeptLeaveApprover", fields: [leaveApproverId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 직원 (근로자/강사/단기근로자 공통)
model Employee {
  id          Int     @id @default(autoincrement())
  empNo       String  @unique // 사번
  name        String
  rrn         String? // 주민등록번호 (암호화 저장 권장 — 데모는 평문)
  birth       String? // 생년월일 YYYY-MM-DD
  department  String? // 부서 (교수부/학습지원팀/조교팀 등)
  position    String? // 직책 (강사/조교/팀장/실장/부장 등)
  duty        String? // 업무 (강의(학급관리) 등)
  address     String?
  phone       String?
  email       String?
  slackUserId String? // 슬랙 연차신청 연동용
  bankName    String? // 급여 입금은행
  bankAccount String? // 급여 입금계좌번호 (숫자만 — 은행 대량이체 파일이 구분자를 받지 않는다)
  /// 예상예금주 — 계좌 명의가 본인과 다를 때만(미성년 조교의 보호자 명의 등). 비면 성명을 쓴다.
  bankHolder  String?

  /// 퇴직유보금 전용 통장 — 유보금은 급여와 **다른 통장으로 따로 송금**한다(확인서 제6조).
  /// 비어 있으면 급여 계좌로 보낸다.
  retentionBank    String?
  retentionAccount String?

  hireDate   DateTime
  resignDate DateTime?
  active     Boolean   @default(true)

  // 세무/보험 형태: EMPLOYEE(4대보험/정규 근로자) | FREELANCE(사업소득 3.3%)
  incomeType String @default("EMPLOYEE")
  // 급여형태: MONTHLY(월급제) | HOURLY(시급제) | INCENTIVE(월급+인센티브) | RATIO(완전비율제/위탁)
  payScheme  String @default("MONTHLY")

  // 보수 기준값
  baseWage      Int @default(0) // 월급제=월기본급, 시급제=시급, 비율제=미사용
  positionAllow Int @default(0) // 직책수당(월)
  mealAllow     Int @default(0) // 식대(월, 비과세)
  carAllow      Int @default(0) // 차량유지비(월, 비과세)
  dependents    Int @default(1) // 부양가족수(본인포함) — 간이세액표용
  nonTaxTotal   Int @default(0) // 기타 비과세 총액(월)

  /// 월 정기주차 비용(원). 급여에서 이 금액의 **50%** 를 주차비로 공제한다(회사 절반 부담).
  /// 0 이면 공제하지 않는다. 보수조건이 아니라 복리후생이라 계약이 아닌 직원 정보에 둔다.
  parkingFee Int @default(0)

  /// 위탁계약(프리랜서) 여부 — 계약(Contract.isContractor)을 비추는 거울.
  /// true 면 주휴·연차·퇴직(유보)금·4대보험·법정가산을 일절 적용하지 않고
  /// 계약서대로 시급 또는 비율로만 지급한다. 완전비율제(RATIO)는 항상 위탁으로 본다.
  isContractor Boolean @default(false)

  // 연차 발생 대상 여부. null = 자동(주 소정근로시간 15시간 이상이면 발생, 근로기준법 §18③)
  // true/false = 계약상 별도로 정한 경우 강제
  leaveEligible Boolean?

  // 시급제(HOURLY) 설정 — 시간기록표의 중간 휴게 30분을 급여에 포함할지
  // true: 기록표 시간 그대로 인정(휴게 유급) / false: 근무일마다 30분 차감(휴게 무급)
  breakPaid Boolean @default(false)

  // 인센티브(INCENTIVE) 설정
  incThreshold      Int? // 학생수 기준 (초과 시 인센 발생)
  incPerStudent     Int? // 초과 1명당 금액
  /// 매출 비율 인센티브 — 담당 학생 수강료 매출의 %(0.15 = 15%).
  /// 인원 기준(incThreshold/incPerStudent)과는 다른 갈래이고, 둘 다 있으면 더해진다.
  incRevenuePercent Float?

  // 포괄임금 약정시간 (월급제/인센티브) — 월 급여에 미리 포함된 시간외·야간 시간
  fixedBaseHours  Float? // 기본급 산정시간(월) — 근로계약서 '기본급 (209시간)'. 없으면 스케줄로 환산
  fixedOtHours    Float? // 약정 시간외근로시간(월) — 근로계약서 '시간외근로(2호)'
  fixedNightHours Float? // 약정 야간근로시간(월) — 근로계약서 '야간근로(3호)'

  // 비율제(RATIO) 설정
  ratioPercent      Float? // 담당 반 매출액의 % (예: 0.5 = 50%)
  ratioMinGuarantee Int? // 위탁 최저보장액(월) — 만근 시 수수료가 이 금액에 못 미쳐도 보장

  // 주간 근로시간표: JSON [{day:"mon",work:true,start:"15:00",end:"22:00",breakH:0.5}, ...]
  schedule String @default("[]")

  contracts         Contract[]
  payrolls          PayrollRecord[]
  incentiveStudents IncentiveStudent[]
  leaveGrants       LeaveGrant[]
  leaveTxns         LeaveTransaction[]
  leaveReqs         LeaveRequest[]
  documents         Document[]
  makeups           MakeupSession[]
  timesheetDays     TimesheetDay[]
  /// 이 직원이 연차 중간결재자로 지정된 부서들
  leaveApproverOf   Department[]       @relation("DeptLeaveApprover")
  severanceBases    SeveranceMonthlyBase[]
  dayOffs           DayOff[]
  attachedFiles     AttachedFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 근로/위탁 계약 (신규→추가→정규 단계 및 재계약 이력)
model Contract {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // 계약단계: SHORT_TERM_1(1년 단기) | RENEWAL_1(1년 추가) | REGULAR(정규) | FIXED_TERM(촉탁) | PART(파트/단기근로)
  stage       String @default("SHORT_TERM_1")
  // 계약서 종류: MONTHLY | HOURLY | INCENTIVE | RATIO | REGULAR | SUMMER 등
  templateKey String @default("MONTHLY")

  startDate        DateTime
  endDate          DateTime? // 정규직은 null 가능
  isProbation      Boolean   @default(true)
  probationMonths  Int       @default(2) // 수습 2개월
  probationEndDate DateTime?

  // 계약 시점 보수 스냅샷 (직원 카드는 이 값을 비추는 거울일 뿐 — lib/contracts.ts)
  incomeType        String? // EMPLOYEE(4대보험) | FREELANCE(사업소득 3.3%)
  baseWage          Int     @default(0)
  positionAllow     Int     @default(0)
  mealAllow         Int     @default(0)
  carAllow          Int     @default(0)
  incThreshold      Int?
  incPerStudent     Int?
  /// 매출 비율 인센티브 (0.15 = 15%) — 인원 기준과 별개 갈래
  incRevenuePercent Float?
  ratioPercent      Float?
  ratioMinGuarantee Int? // 위탁 최저보장액(월)
  /// 위탁계약(프리랜서) — 주휴·연차·퇴직금·4대보험 등 근로기준법 항목을 일절 적용하지 않는다.
  /// 완전비율제(RATIO)는 성질상 항상 위탁이라 이 값과 무관하게 제외된다.
  isContractor      Boolean @default(false)
  fixedBaseHours    Float? // 포괄임금 기본급 산정시간(월)
  fixedOtHours      Float? // 포괄임금 약정 시간외근로시간(월)
  fixedNightHours   Float? // 포괄임금 약정 야간근로시간(월)

  status  String  @default("ACTIVE") // ACTIVE | EXPIRED | TERMINATED | DRAFT
  pdfPath String?
  note    String?

  /// 계약 종료 예고 알림을 보낸 시각 (경영지원 슬랙 알림).
  /// **한 계약에 한 번만** 보내려고 새긴다 — 매일 같은 알림이 오면 아무도 안 읽는다.
  /// 예고 조건을 '오늘이 딱 N일 전인가' 가 아니라 '창 안에 들었는데 아직 안 알렸는가' 로
  /// 두었기에 필요한 자리다(lib/hr-notify.ts).
  expiryNotifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files AttachedFile[]

  @@index([employeeId])
}

/// 직원에게 딸린 **첨부 파일** — 계약서 서명본 스캔과 인사서류·동의서·서약서를 함께 담는다.
///
/// 붙는 자리가 둘이다. **정확히 하나만 채운다**:
///  · `contractId` — 그 계약의 **서명본 스캔**. 계약 이력 카드 안에 붙는다.
///    시스템이 뽑는 계약서(`genContract`)와 다른 물건이다 — 그쪽은 지금 조건으로 새로 만드는
///    서식이라 조건을 고치면 따라 바뀌지만, 서명·날인해 주고받은 원본은 그대로 남아야 한다.
///  · `employeeId` — 계약과 무관한 **직원 서류함**(사본·동의서·서약서·자격증 등).
///
/// 모델 이름은 `AttachedFile` 이지만 테이블은 `ContractFile` 그대로 쓴다(`@@map`) —
/// 이미 배포된 표라 이름을 바꾸면 `prisma db push` 가 지우고 다시 만든다.
///
/// **파일을 DB 에 담는다**(로고·인감과 같은 사정 — 서버리스에 쓸 수 있는 경로가 없다).
/// 다만 data URI 가 아니라 **bytea(Bytes)** 다: base64 는 덩치가 1/3 늘고 스캔본은 장당
/// 수백 KB~수십 MB 라 그 차이가 그대로 DB 용량이 된다.
/// ⚠ **목록 조회에서 `data` 를 select 하지 않는다** — 한 화면에 수십 MB 가 딸려 온다.
model AttachedFile {
  id Int @id @default(autoincrement())

  /// 계약 서명본이면 그 계약 (직원 서류함이면 null)
  contractId Int?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// 직원 서류함이면 그 직원 (계약 서명본이면 null)
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// 올린 파일 이름 (한글 그대로. 내보낼 때 RFC 5987 로 감싼다)
  name String
  /// 저장한 형식 — 확장자가 아니라 **파일 앞머리로 가린 것**(lib/contract-file.ts).
  /// 앞머리로 못 가린 형식은 `application/octet-stream` 으로 담고 열 때 내려받게 한다.
  mime String
  size Int
  /// 파일 본문. 조각을 다 받아 이어 붙이기 전까지는 비어 있다
  data Bytes?

  /// 메모 — "원본 보관함 3번" 처럼 종이 원본이 어디 있는지 적는 자리
  note String?

  /// 조각을 다 받아 이어 붙였는가. **완성된 것만 화면에 낸다** —
  /// 반쯤 올라간 파일이 목록에 뜨면 열었을 때 깨진 문서가 나온다.
  complete Boolean @default(true)
  /// 업로드 한 건을 가리키는 열쇠 (브라우저가 조각마다 들고 온다).
  /// **유니크를 걸지 않는다** — `randomUUID()` 라 부딪칠 일이 없는데, 유니크 제약을 추가하는
  /// 변경은 `prisma db push` 가 'data loss' 경고로 띄우고 `db-deploy.mjs` 가 거기서 배포를
  /// 멈춘다(안전장치는 그대로 두는 게 맞다). 조회는 `findFirst` + 인덱스로 충분하다.
  uploadId String?

  uploadedAt DateTime @default(now())

  chunks AttachedFileChunk[]

  @@index([contractId])
  @@index([employeeId])
  @@index([complete])
  @@index([uploadId])
  @@map("ContractFile")
}

/// 올리는 중인 파일의 **조각**.
///
/// 이어 붙이려고 잠깐 쌓아 두는 자리다. 다 받으면 한 번에 이어 `AttachedFile.data` 에 넣고
/// 여기서는 지운다 — 조각마다 `data = data || 조각` 으로 덧붙이면 Postgres 가 그 행을 매번
/// 통째로 다시 쓰기 때문에 파일이 클수록 쓰기량이 제곱으로 는다.
model AttachedFileChunk {
  id     Int          @id @default(autoincrement())
  fileId Int
  file   AttachedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  /// 조각 번호 (0부터)
  index Int
  data  Bytes

  @@unique([fileId, index])
  @@index([fileId])
  @@map("ContractFileChunk")
}

/// 평일 휴무 — **연차가 아니다.**
///
/// 운영팀은 그 주 토요일에 당번 근무를 하고 대신 그 주 평일 하루를 쉰다. 근로시간을 옮겨 놓은
/// 것이라 연차 잔여에서 깎지 않는다. 그래서 `LeaveTransaction`(연차 원장)에 넣지 않고 따로 둔다 —
/// 원장에 넣으면 `summarizeLeave` 가 훑어 잔여가 조용히 줄어든다.
///
/// 원본은 **구글 연차 캘린더의 `(휴무)김수민` 일정**이고 사람이 손으로 넣는다.
/// 이 표는 그 사본이라 동기화가 **캘린더에서 사라진 줄을 지운다**(공휴일 표와 반대다).
model DayOff {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime

  /// 캘린더 제목 원문 — 사람이 눈으로 대조할 수 있게 그대로 남긴다
  title       String?
  gcalEventId String?
  /// GCAL(캘린더에서 가져옴) | MANUAL(관리자가 직접 넣음 — 동기화가 지우지 않는다)
  source      String  @default("GCAL")
  note        String?

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

/// 경영지원 알림 설정 — 계약 종료 예고 · 생일 (단일 행, id=1)
///
/// 발송 시기·시각을 **코드가 아니라 설정으로** 둔 이유: 실무가 바뀌면 배포 없이 고쳐야 하고,
/// 지금 무엇이 언제 나가게 되어 있는지가 화면에 남아야 한다.
model HrNotifySetting {
  id Int @id @default(1)

  /// 알림을 받을 부서 — 재계약·경조사 실무를 맡는 곳
  targetDepartment String  @default("경영지원")
  /// 채널로 보낼지 (비면 부서 소속 직원에게 각각 DM)
  channel          String?

  // 계약 종료 예고
  contractEnabled   Boolean   @default(true)
  /// 며칠 전에 알릴지 (60일 ≈ 2개월)
  contractLeadDays  Int       @default(60)
  contractHour      Int       @default(12)
  contractMinute    Int       @default(0)
  contractLastRunAt DateTime?

  // 생일
  birthdayEnabled   Boolean   @default(true)
  /// 0 = 당일. 미리 챙길 것이 있으면 앞당길 수 있다
  birthdayLeadDays  Int       @default(0)
  birthdayHour      Int       @default(12)
  birthdayMinute    Int       @default(0)
  birthdayLastRunAt DateTime?

  // 운영진 일일 안내 — 오늘 휴가 · 오늘 보강
  // 위의 두 알림과 **받는 곳이 다르다**(경영지원 부서 ↔ 운영진 채널). 그래서 채널을 따로 둔다.
  dailyEnabled Boolean @default(true)
  /// 운영진 채널 ID. **비면 보내지 않는다** — 전 직원 일정이라 DM 으로 흩뿌릴 성격이 아니다
  dailyChannel String? @default("C0AP5EWJR71")
  dailyHour    Int     @default(14)
  dailyMinute  Int     @default(0)
  /// 휴가·보강을 **따로 새긴다** — 한쪽 발송이 실패해도 다른 쪽이 막히지 않게
  dailyLeaveLastRunAt  DateTime?
  dailyMakeupLastRunAt DateTime?

  updatedAt DateTime @updatedAt
}

/// 월별 급여/사업소득 명세 기록
model PayrollRecord {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int

  incomeType String // EMPLOYEE | FREELANCE (계산 시점 스냅샷)
  payScheme  String

  // 월별 입력값
  workedHours        Float? // 시급제 실근로시간 (시간기록표 업로드 시 자동 입력)
  weeklyHolidayHours Float? // 시급제 주휴시간(월 합계) — 시간기록표 기반 산정 시 입력
  extraHours         Float  @default(0) // 법내연장시간(월, 가산없음 ×1.0)
  overtimeHours      Float  @default(0) // 연장근로시간(월, 법정초과 ×1.5)
  nightHours         Float  @default(0) // 야간근로시간(월)
  holidayHours       Float  @default(0) // 휴일근로시간(월, 8시간 이내 ×1.5)
  holidayOverHours   Float  @default(0) // 휴일근로 중 1일 8시간 초과분(월, ×2.0 — 근로기준법 §56②)
  studentCount       Float? // 인센티브용 학생수 — 재원계수 소수 입력 허용 (회차÷8 = 0.125 단위, 셋째자리까지)
  studentUnits       Float? // 인센티브 가중 인원 (명단 기반, 월중 입학·전출·퇴원 반영 0.x 가능)
  classRevenue       Int? // 비율제용 반 매출액
  bonus              Int    @default(0) // 특별상여
  incentiveManual    Int    @default(0) // 수동 인센티브 조정
  unusedLeaveDays    Float  @default(0) // 연차미사용수당 일수
  prorationRatio     Float  @default(1) // 일할계산 비율 (월중 입/퇴사)

  // 계산 결과 (원)
  baseP          Int @default(0) // 기본급
  extraP         Int @default(0) // 추가근로수당(법내연장)
  overtimeP      Int @default(0) // 연장근로수당
  nightP         Int @default(0) // 야간근로수당
  holidayP       Int @default(0) // 휴일근로수당
  weeklyHolidayP Int @default(0) // 주휴수당(시급제)
  positionP      Int @default(0) // 직책수당
  mealP          Int @default(0) // 식대
  carP           Int @default(0) // 차량유지비
  incentiveP     Int @default(0) // 인센티브
  bonusP         Int @default(0) // 상여
  unusedLeaveP   Int @default(0) // 연차미사용수당
  gross          Int @default(0) // 지급액 계

  // 공제
  // 공제모드: MANUAL(세무사 지정값 직접입력, 기본) | AUTO(엔진 자동산출)
  deductMode  String  @default("MANUAL")
  pensionD    Int     @default(0) // 국민연금
  employmentD Int     @default(0) // 고용보험
  healthD     Int     @default(0) // 건강보험
  longTermD   Int     @default(0) // 장기요양
  incomeTaxD  Int     @default(0) // 소득세 (근로 or 사업 3%)
  localTaxD   Int     @default(0) // 지방소득세
  retentionD  Int     @default(0) // 퇴직유보금 (인센티브 원천액의 8.3%, 별도통장 송금)
  parkingD    Int     @default(0) // 월 정기주차비 공제 (본인부담분)
  expenseD    Int     @default(0) // 실비 정산 (+공제 / -환급)
  otherD      Int     @default(0) // 기타공제/정산 (항목 합계)
  otherItems  String? // 기타공제 세부 항목 JSON [{name, amount}]
  totalDeduct Int     @default(0) // 공제액 계
  net         Int     @default(0) // 실수령액

  hourlyWage Float  @default(0) // 통상시급(스냅샷)
  breakdown  String @default("{}") // 상세 계산근거 JSON

  status    String    @default("DRAFT") // DRAFT | CONFIRMED | SENT
  emailedAt DateTime? // 마지막 발송 시각
  pdfPath   String?

  // --- 정정 발급 이력 ---
  // 발송(SENT)하면 잠기지만, 뒤늦게 잘못이 드러나면 사유를 남기고 풀 수 있다
  // (POST /api/payroll/[id]/unlock). 그때 아래 값이 채워지고, 다시 보낸 명세서는
  // '정정 발급' 으로 표시된다 — 직원이 받은 두 통 중 어느 것이 최종본인지 문서에 드러나야 한다.
  /// 최초로 발송한 시각. 정정본에 '최초 발급일' 로 찍힌다(emailedAt 은 매번 덮이므로 따로 둔다)
  firstSentAt  DateTime?
  /// 잠금을 푼 횟수 = 정정 발급 차수. 0 이면 정정된 적 없는 원본이다
  reissueCount Int       @default(0)
  /// 마지막 잠금 해제 사유. **내부 감사용**이라 명세서·메일에는 싣지 않는다
  unlockReason String?

  /// 그 달 재직 기간이 없는데 관리자가 일부러 시트에 올린 기록(퇴직자 미지급분 정산 등).
  /// 배치 재산정이 **지우지 않고 그대로 다시 계산**하는 표시다 — 이 표시가 없는
  /// '재직 기간 없는 기록' 은 전월 퇴직자가 남은 것으로 보고 시트에서 뺀다.
  manualAdd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([year, month])
}

/// 연차 부여 이력 (근속연수/입사1년미만 월단위 부여)
model LeaveGrant {
  id          Int      @id @default(autoincrement())
  employeeId  Int
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  grantDate   DateTime // 부여일
  expiryDate  DateTime // 소멸일 (통상 부여일+1년, 회계연도/입사일 기준)
  days        Float // 부여일수
  // 사유: MONTHLY(1년미만 개근 1일) | ANNUAL(연차 15~25일) | ADJUST(수동조정)
  source      String   @default("ANNUAL")
  serviceYear Int      @default(0) // 근속연차 (0=1년미만)
  note        String?
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

/// 연차 사용/조정 트랜잭션 (+부여 / -사용)
model LeaveTransaction {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // 발생일 (사용일 또는 부여일)
  days       Float // +부여, -사용
  type       String // GRANT | USE | ADJUST | EXPIRE | PAYOUT
  // 연차 종류: STATUTORY(본래 연차, 근로기준법) | COMP(대체휴일 보상연차 — 운영자 수동 부여)
  category   String   @default("STATUTORY")
  note       String?
  requestId  Int? // 연결된 연차신청
  createdAt  DateTime @default(now())

  @@index([employeeId])
}

/// 연차 신청 (슬랙 → 관리자 승인)
model LeaveRequest {
  id           Int       @id @default(autoincrement())
  employeeId   Int
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime
  days         Float // 신청 일수 (0.5 반차 지원)
  leaveType    String    @default("ANNUAL") // ANNUAL(연차) | HALF(반차) | COMP | SICK | SPECIAL
  reason       String?
  workPlan     String? // 업무조치사항 (부재 중 수업·업무 처리 계획)
  status       String    @default("PENDING") // PRE_PENDING(중간결재 대기) | PENDING | APPROVED | REJECTED | CANCEL_PENDING | CANCELED
  source       String    @default("WEB") // WEB | SLACK
  slackChannel String?
  slackTs      String? // 슬랙 메시지 timestamp (승인버튼 갱신용)
  approverId   String? // 승인자 (slack user or admin)
  decidedAt    DateTime?
  decidedNote  String?

  // 구글 캘린더 연동 (승인 시 생성, 취소 승인 시 삭제)
  calendarEventId String?

  // 중간결재 (부서에 leaveApprover 가 지정된 경우 PRE_PENDING → 확인 후 PENDING)
  preApproverId String? // 확인한 사람 (slack user id, 운영진 대행이면 "admin")
  preDecidedAt  DateTime?

  // 취소 신청 (직원이 승인된 휴가를 취소 요청 → 운영진 승인 필요)
  cancelReason      String?
  cancelRequestedAt DateTime?
  cancelDecidedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
}

/// 생성된 문서 (계약서 PKG, 증명서, 명세서 등)
model Document {
  id         Int       @id @default(autoincrement())
  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // 종류: NEWHIRE_PKG | CONTRACT | PLEDGE | CONSENT | PAYSLIP | CERT_EMPLOYMENT | CERT_CAREER | CERT_INCOME 등
  type       String
  title      String
  filePath   String? // 저장된 PDF 경로
  meta       String    @default("{}")
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

/// 급여명세서 자동발송 스케줄
model EmailSchedule {
  id                Int       @id @default(autoincrement())
  name              String    @default("급여명세서 자동발송")
  enabled           Boolean   @default(false)
  // 주기: MONTHLY(매월 특정일) | WEEKLY(매주 특정요일)
  frequency         String    @default("MONTHLY")
  dayOfMonth        Int       @default(7) // MONTHLY: 지급일
  dayOfWeek         Int       @default(1) // WEEKLY: 0=일 .. 6=토
  hour              Int       @default(9)
  minute            Int       @default(0)
  // 발송 대상 월 오프셋: 0=당월, -1=전월분
  targetMonthOffset Int       @default(0)
  lastRunAt         DateTime?
  nextRunAt         DateTime?
  updatedAt         DateTime  @updatedAt
}

/// 이메일 발송 로그
model EmailLog {
  id        Int       @id @default(autoincrement())
  to        String
  subject   String
  status    String    @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  payrollId Int?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([payrollId])
}

/// 감사 로그 (승인/발송/발급 등 주요 이벤트)
/// 작업 이력 — 급여·명세서·계약처럼 되돌리기 어려운 작업이 언제 무엇에 일어났는지 남긴다.
/// 관리자 로그인은 비밀번호 공유 방식이라 '누가' 는 슬랙 경유 작업에서만 특정된다.
model AuditLog {
  id         Int      @id @default(autoincrement())
  actor      String   @default("system") // ADMIN(공유 로그인) | SLACK | CRON | system
  actorName  String? // 슬랙 사용자명 등 특정 가능한 경우
  action     String
  target     String? // 대상 요약 (직원명 · 2026-08 등)
  employeeId Int?
  summary    String? // 사람이 읽는 한 줄
  detail     String   @default("{}")
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([employeeId])
}

/// 인센티브 학생 명단 (월급+인센티브 강사, 강사·연월 단위 스냅샷)
model IncentiveStudent {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  year       Int
  month      Int

  seq          Int?
  // 재원(ENROLLED) | 전출(TRANSFERRED) | 퇴원(WITHDRAWN)
  status       String    @default("ENROLLED")
  name         String
  className    String?
  school       String?
  enrollDate   DateTime?
  withdrawDate DateTime?
  // 해당 월 실제 수업 회차 (null = 만근)
  sessions     Float?
  // 월 표준 회차 (기본 8회)
  fullSessions Float     @default(8)
  // 재원계수 0~1 (= sessions / fullSessions, 상한 1)
  weight       Float     @default(1)

  // --- 매출 기준 명단(완전비율제 사업소득 · 매출비율 인센티브)에만 있는 값 ---
  /// ① 그 달 이 학생의 수강료 매출(원). null = 인원 기준 명단이라 매출 열이 없음
  revenue      Int?
  /// 명단에 적혀 있던 배분율(0.45 = 45%). 계산은 계약 값으로 하고 이 값은 대조용이다
  sharePercent Float?

  createdAt DateTime @default(now())

  @@index([employeeId, year, month])
}

/// 보강 · 주말근무 사전신청 — 슬랙으로 직원이 직접 등록(승인 절차 없음).
/// 실근무 시각이 확정되면 오버타임 수당 산정의 원장이 된다.
/// 확정은 **근무 다음날부터 신청자가 직접** 하고, 관리자가 최종적으로 다시 고칠 수 있다.
/// 시각은 **KST 벽시계 값을 UTC 필드에 그대로** 담는다(앱 전체 규칙).
model MakeupSession {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // --- 신청 내용 (슬랙 양식 그대로) ---
  planStart   DateTime // 근무 시작 시간(예정)
  planEnd     DateTime // 근무 종료 시간(예정)
  /// IMMEDIATE(직전보강) | MANDATORY(내신의무보강) | ABSENCE(결시보강) | OTHER(기타)
  /// | WEEKEND(주말근무 — 교수부가 아닌 직원의 주말 근무. 보강이 아니라 캘린더에 올리지 않는다)
  category    String
  targetClass String // 대상반 (개별 보강이면 학생 이름) / 주말근무는 담당 업무
  headcount   Int? // 수강 예상인원 (주말근무는 쓰지 않는다)
  detail      String   @default("") // 세부 보강내역 / 근무내역
  note        String? // 기타 특이사항

  // --- 실근무 확정 ---
  // PLANNED(신청됨) | CONFIRMED(실근무 확정) | NOSHOW(미실시) | CANCELED(취소)
  status      String    @default("PLANNED")
  actualStart DateTime? // 실근무 시작 (미입력 시 확정할 때 예정값으로 채움)
  actualEnd   DateTime?
  reviewNote  String? // 확정 메모 (신청자·관리자 공용)
  reviewedAt  DateTime?

  /// 누가 확정했는가 — EMPLOYEE(신청자 본인) | ADMIN(관리자).
  /// 관리자가 나중에 고치면 ADMIN 으로 덮인다(최종 권한은 관리자에게 있다).
  confirmedBy String?
  confirmedAt DateTime?

  /// '실근무 시간을 확정해 주세요' 알림을 보낸 시각 — 같은 건에 두 번 보내지 않기 위함.
  /// 수당이 기본 반영되는 유형은 근무 다음날 자동으로, 그 외는 관리자가 눌러서 보낸다.
  confirmNotifiedAt DateTime?

  /// 수당 반영 여부 — null 이면 카테고리 기본값(OvertimePolicy).
  /// 결시보강처럼 건건이 판단해야 하는 건 관리자가 여기서 켜고 끈다.
  payEligible Boolean?

  source      String  @default("SLACK") // SLACK | WEB
  slackUserId String?
  gcalEventId String? // 보강캘린더 일정 ID (수정·삭제 동기화용)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, planStart])
  @@index([planStart])
}

/// 내신 기간 (연 4회) — 내신의무보강 수당 인정 상한(기간당 10시간)의 적용 단위
model ExamPeriod {
  id        Int      @id @default(autoincrement())
  name      String // "2026년 1학기 중간고사"
  startDate DateTime
  endDate   DateTime
  capHours  Float    @default(10) // 이 기간에 인정할 내신의무보강 시간 상한

  @@index([startDate])
}

/// 오버타임 수당 지급 조건 (단일 행, id=1). 화면(설정)에서 수정한다.
model OvertimePolicy {
  id Int @id @default(1)

  // 가산 배수
  // 평일 소정 외·토요일은 주 40시간 안쪽이라 법정 가산 대상이 아니다(법내연장 ×1.0).
  // 가산은 휴일근로에만 붙는다 — 1일 8시간·주 40시간 초과분까지 가산하려면 아래 스위치를 켠다.
  extraMultiplier        Float   @default(1.0) // 법내연장 (평일 소정 외·토요일)
  overtimeMultiplier     Float   @default(1.5) // 법정연장 (1일 8h·주 40h 초과분)
  applyStatutoryOvertime Boolean @default(false) // 켜면 초과분을 법정 가산으로 올린다
  holidayMultiplier      Float   @default(1.5) // 휴일근로 (일요일·공휴일) 8시간 이내
  holidayOverMultiplier  Float   @default(2.0) // 휴일근로 8시간 초과분
  holidayOverAfterHours  Float   @default(8)
  nightMultiplier        Float   @default(0.5) // 야간(22~06) 가산
  nightStartHour         Int     @default(22)
  nightEndHour           Int     @default(6)
  countNight             Boolean @default(false) // 야간 가산 — 기본 꺼짐

  // 내신의무보강 상한 (ExamPeriod.capHours 가 있으면 그쪽 우선)
  mandatoryCapHours Float @default(10)

  // 인정시간 반올림 단위(분). 0 = 반올림하지 않음
  roundingMinutes Int @default(0)

  // 카테고리별 '수당 반영' 기본값 (MakeupSession.payEligible 이 null 일 때)
  immediateDefault Boolean @default(true) // 직전보강 — 대상
  mandatoryDefault Boolean @default(true) // 내신의무보강 — 대상(상한 적용)
  absenceDefault   Boolean @default(false) // 결시보강 — 관리자가 건건이 판단
  otherDefault     Boolean @default(false)
  // 주말근무 — 실제로 나와 일한 것이라 기본 반영. 상한(내신)은 적용되지 않는다.
  weekendDefault   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// 시간기록표 일별 원본 — 업로드할 때마다 upsert 한다.
/// 주휴 개근 판정은 월~일 한 주를 통째로 봐야 하는데 기록표는 달 단위로 올라와,
/// 달을 걸친 주(예: 7/27~8/2)를 다음 달에 계산할 때 앞달 출근 기록이 없어
/// 결근으로 잘못 잡혔다. 그래서 올린 기록을 남겨 두고 앞뒤 달을 함께 본다.
model TimesheetDay {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  /// 기록표 원본 시간 (출근~퇴근, 휴게 차감 전)
  hours      Float
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

/// 퇴직급여 산정 조건 (단일 행, id=1). 화면(퇴직급여 → 산정 조건)에서 수정한다.
///
/// 유쌤에듀는 **근속 1년이 지나면 DC형 퇴직연금에 가입**한다. 그 전 기간은 납입할 계정이
/// 없어 회사가 충당금으로 쌓아 두고, 1년을 넘기면 입사일부터 전체 기간이 지급 대상이 되므로
/// (근로자퇴직급여보장법 §8①) 그 충당금이 곧 **소급 납입할 몫**이 된다.
///
/// 산입 범위를 상수가 아니라 설정으로 둔 이유: 무엇을 임금총액에 넣을지는 노무 자문으로
/// 바뀔 수 있는 판단이다. 상수로 두면 바꿀 때마다 배포해야 하고, 무엇을 뺐는지가 화면에
/// 남지 않는다.
model SeverancePolicy {
  id Int @id @default(1)

  /// 근속 몇 개월이 지나면 DC 부담금으로 넘어가는가 (유쌤에듀 = 12개월)
  dcAfterMonths  Int   @default(12)
  /// 연간 임금총액을 나누는 수 — 법정 하한이 1/12 이다 (근로자퇴직급여보장법 §20①)
  divisor        Int   @default(12)
  /// 이 시간 미만이면 대상에서 뺀다 (§4① 단서 = 주 15시간)
  minWeeklyHours Float @default(15)

  // 산입 범위 — 기본값은 '상여·인센티브·오버타임 제외'
  includeBonus         Boolean @default(false) // 비정기 특별상여
  includeIncentive     Boolean @default(false) // 이미 퇴직유보금으로 1/12 을 떼고 있다
  /// 포괄임금 약정 시간외·야간 — 계약서 제4조에 이미 들어 있는 고정분.
  /// 켜면 산정기준 임금이 **계약서에 합의된 월 급여총액**과 맞는다(기본 켜짐).
  includeFixedOvertime Boolean @default(true)
  /// 그 달 실제 발생한 연장·야간·휴일수당(보강 확정분·수기 입력분).
  /// ⚠ 끄면 법정 하한에 미달할 수 있다
  includeOvertime      Boolean @default(false)
  includeUnusedLeave   Boolean @default(true)
  includeMealCar       Boolean @default(true) // 비과세지만 정기·일률 지급이면 임금이다

  updatedAt DateTime @updatedAt
}

/// 월별 퇴직급여 **산정기준 임금** — 급여 레코드에서 나오지 않는 달을 메우거나 사람이 고친 값.
///
/// 퇴직급여는 원래 그 달 급여에서 파생되지만(lib/severance-service.ts), 두 경우에 이게 필요하다:
///  · **도입 이전 기간** — 시스템에 급여 레코드가 없던 달. 계약 이력에서 추산해 넣는다(ESTIMATED).
///  · **관리자 정정** — 추산이 틀렸거나 계약에 안 잡히는 사정이 있을 때 직접 고친다(MANUAL).
///
/// 우선순위는 **MANUAL > 급여 레코드 > ESTIMATED** 다. 사람이 고친 값이 가장 세고,
/// 실제 급여가 있으면 추산보다 그쪽이 맞다 — 추산은 '급여가 없을 때 메우는 값' 이기 때문이다.
model SeveranceMonthlyBase {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year  Int
  month Int
  /// 산정기준 임금(원). 월 적립액 = 이 값 ÷ 12
  base  Int

  /// ESTIMATED(계약에서 추산 — 마이그레이션) | MANUAL(관리자가 직접 지정)
  source String  @default("MANUAL")
  /// 어떻게 나온 값인지 (추산 근거·정정 사유). 화면에 그대로 띄운다
  note   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year, month])
  @@index([employeeId])
}
