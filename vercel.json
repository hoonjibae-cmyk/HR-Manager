{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["icn1"],
  "crons": [
    { "path": "/api/cron", "schedule": "0 * * * *" },
    { "path": "/api/calendar-alerts", "schedule": "* * * * *" }
  ],
  "functions": {
    "app/api/documents/**/route.ts": { "maxDuration": 120 },
    "app/api/email/**/route.ts": { "maxDuration": 300 },
    "app/api/payroll/**/route.ts": { "maxDuration": 120 },
    "app/api/cron/route.ts": { "maxDuration": 300 },
    "app/api/calendar-alerts/route.ts": { "maxDuration": 300 }
  }
}
